{
  "name": "openanimalnet",
  "version": "1.18.18",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test src/lib/animalFiltering.test.ts src/lib/rateLimit.test.ts src/lib/geo.test.ts src/lib/interactMatching.test.ts src/lib/observations.test.ts",
    "test:api": "node --test tests/api.integration.test.ts",
    "refresh:data": "node .freebuff/refresh-sources.mjs",
    "verify:data": "node .freebuff/verify-multisource.mjs",
    "check:taxonomy": "node .freebuff/check-taxonomy.mjs",
    "species:add": "node .freebuff/generate-species.mjs",
    "mobile:setup": "bash scripts/setup-mobile.sh",
    "mobile:build": "MOBILE_BUILD=true npm run build",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:android": "npm run mobile:sync && npx cap open android"
  },
  "dependencies": {
    "@react-leaflet/core": "^2.0.0",
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.10.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
